# Vision Model API Keys
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://aivision:password@localhost:5432/aivision
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local  # Options: local, s3, minio
S3_BUCKET=aivision-documents
S3_ENDPOINT=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Application Settings
SECRET_KEY=your-secret-key-change-this-in-production
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
ALLOWED_HEADERS=*

# Document Processing
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff,heic
PDF_DPI=300
MAX_CONCURRENT_EXTRACTIONS=20

# Model Defaults
DEFAULT_VISION_MODEL=gemini-2.0-flash-exp
CONFIDENCE_THRESHOLD=0.70
ENABLE_MODEL_FALLBACK=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Feature Flags
ENABLE_BATCH_PROCESSING=True
ENABLE_CUSTOM_TEMPLATES=True
ENABLE_ANALYTICS=True
ENABLE_WEBHOOKS=False

# =============================================================================
# VERCEL DEPLOYMENT SETTINGS
# =============================================================================

# Vercel Postgres (automatically set when using Vercel Postgres)
# POSTGRES_URL=postgres://...
# POSTGRES_PRISMA_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...

# Frontend Environment (set in Vercel dashboard or frontend/.env)
# VITE_API_URL=https://your-backend-url.com

# Vercel-specific
# VERCEL_URL (auto-set by Vercel)
# VERCEL_ENV (auto-set by Vercel: production, preview, development)
